# CommRaT environment configuration
#
# This file is committed to git. It provides defaults for local development
# and is sourced by scripts/run-local-evl-tests.sh.
#
# Non-secret values only. Tokens and credentials belong in CI secrets or
# your local shell profile, never here.
#
# To override values for your machine without touching this file, create
# .commrat.env.local (gitignored) with only the variables you want to change.
#
# These values are also hardcoded in .github/workflows/ci.yml (container.image,
# dawidd6 artifact download). Keep them in sync when the RaTOS image changes.

# RaTOS developer container image (public GHCR, no authentication required)
RATOS_IMAGE_REF=ghcr.io/mattih11/ratos-dev-image:latest

# RaTOS GitHub repository used to locate workflow run artifacts
# Must be "owner/repo" format for the gh CLI
RATOS_RELEASE_REPO=mattih11/RaTOS

# Pinned RaTOS release tag — must be compatible with this version of CommRaT.
# Update this (and test) when upgrading RaTOS. Override in .commrat.env.local
# to test against a newer or pre-release version without touching this file.
# Leave unset to fall back to the latest successful run on main (CI/dev only).
RATOS_RELEASE_TAG=v0.1.1

# QEMU resource defaults (adjust for your host machine)
QEMU_MEMORY=4G
QEMU_CPUS=4
SSH_PORT=22222

# RaTOS SDK install prefix (for scripts/evl-dev.sh --cross).
# The SDK is downloaded and extracted automatically on first use — no manual
# setup required. The default path is inside .evl-cache/ (gitignored).
# Override in .commrat.env.local if you want a different location.
EVL_SDK_DIR=.evl-cache/sdk
