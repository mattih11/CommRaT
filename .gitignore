# Build directories
build/
cmake-build-*/

# CMake preset build directories
build/default/
build/debug/
build/evl/

# Local environment overrides (machine-specific, not committed)
.commrat.env.local

# EVL artifact cache (downloaded by scripts/run-local-evl-tests.sh)
.evl-cache/

# Doxygen output
docs/api/

# Optional dependencies (if present as symlinks)
SeRTial
tims
rack

# hints for related projects
rfl

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Compiled files
*.o
*.a
*.so
*.dylib

# Executables
test_sender
test_receiver
example_*
# Re-include source files inside examples/ that match the pattern above
!examples/*.cpp
!examples/*.hpp

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# Backup files
*.backup
*.bak

# Logs
*.log
